# DEVAI-035, DEVAI-127: local mode starts without organizational credentials; protected API calls remain denied.
ODS_GATEWAY_PORT=8080
# Set a stable 32-byte Base64 key before persistent sessions; required in production.
ODS_DATA_KEY_BASE64=
ODS_BIND_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local
ODS_OIDC_ISSUER=https://sso.organisation.example/realms/development
ODS_OIDC_CLIENT_ID=ods-vscode
ODS_API_AUDIENCE=ods-gateway
ODS_GITLAB_URL=https://gitlab.organisation.example
ODS_GOVERNANCE_PROJECT_ID=<GOVERNANCE_PROJECT_ID>
ODS_GOVERNANCE_REF=main
ODS_GOVERNANCE_TOKEN=<READ_ONLY_GOVERNANCE_TOKEN>
ODS_POLICY_PUBLIC_KEY=<ED25519_DER_PUBLIC_KEY_BASE64>
ODS_MISTRAL_URL=https://api.mistral.ai
ODS_MISTRAL_MODEL=<APPROVED_MISTRAL_MODEL_ID>
ODS_MODEL_ALIAS=mistral-coding-approved
ODS_MISTRAL_API_KEY=<MISTRAL_API_KEY>
ODS_SONAR_URL=https://sonar.organisation.example
ODS_SONAR_TOKEN=<SONAR_READ_TOKEN>
ODS_JFROG_URL=https://jfrog.organisation.example
ODS_JFROG_TOKEN=<XRAY_READ_TOKEN>
ODS_RUNNER_PROJECT_ID=<DEDICATED_GITLAB_SCANNER_PROJECT_ID>
ODS_RUNNER_REF=main
ODS_RUNNER_TOKEN=<SCANNER_PIPELINE_TOKEN>
# Optional signed organizational prompt directory, deployed atomically by governance CI.
ODS_PROMPT_DIRECTORY=
ODS_PROMPT_PUBLIC_KEY=
# Production: select production, configure PostgreSQL and put TLS in front of the gateway.
# ODS_DATABASE_URL=jdbc:postgresql://<DATABASE_HOST>:5432/ods
# ODS_DATABASE_USER=<DATABASE_USER>
# ODS_DATABASE_PASSWORD=<DATABASE_PASSWORD>
