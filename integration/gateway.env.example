# HMSile dev IA - modele administrateur, sans aucun secret reel.
# DEVAI-127, DEVAI-167, DEVAI-169, DEVAI-171, DEVAI-176.
# Copier dans integration/local avant de saisir les valeurs confidentielles.
# Les domaines .example, les comptes et les IDs ci-dessous sont fictifs.
# Syntaxe litterale CLE=valeur : pas de guillemets ni de commentaire en fin de ligne.

# Mistral via le backend Vibe embarque par defaut.
ODS_LLM_TRANSPORT=VIBE_CLI
ODS_MISTRAL_URL=https://mistral.hmsile.example
ODS_VIBE_URL=https://mistral.hmsile.example/v1
ODS_MISTRAL_MODEL=<APPROVED_MISTRAL_MODEL_ID>
ODS_MODEL_ALIAS=hmsile-coding-approved
ODS_VIBE_AUTH=API_KEY
ODS_MISTRAL_API_KEY=<MISTRAL_VIBE_API_KEY>
ODS_VIBE_TOKEN=

# JFrog Xray : compte de service Basic par defaut.
ODS_JFROG_URL=https://jfrog.hmsile.example
ODS_JFROG_AUTH=BASIC
ODS_JFROG_USERNAME=svc-hmsile-xray
ODS_JFROG_PASSWORD=<JFROG_SERVICE_PASSWORD>
ODS_JFROG_TOKEN=
ODS_JFROG_WATCH=hmsile-dev-watch
ODS_JFROG_PROJECT_KEY=

# Sonar : token de service avec droits d'analyse et de lecture.
ODS_SONAR_URL=https://sonar.hmsile.example
ODS_SONAR_USERNAME=svc-hmsile-sonar
ODS_SONAR_TOKEN=<SONAR_ANALYSIS_API_KEY>

# GitLab : username du compte de service = svc-hmsile-governance.
# Ce nom est un inventaire administratif ; seule la variable TOKEN authentifie l'API.
# Il n'existe pas de parametre applicatif ODS_GITLAB_USERNAME.
ODS_GITLAB_URL=https://gitlab.hmsile.example
ODS_GOVERNANCE_PROJECT_ID=2001
ODS_GOVERNANCE_REF=main
ODS_GOVERNANCE_TOKEN=<GITLAB_GOVERNANCE_SERVICE_TOKEN>
ODS_POLICY_PUBLIC_KEY=<ED25519_DER_PUBLIC_KEY_BASE64>

# Optionnel : bundle externe de prompts signe, laisse desactive ici.
ODS_PROMPT_DIRECTORY=
ODS_PROMPT_PUBLIC_KEY=

# Vide : le gateway embarque utilise une cle stable generee dans SecretStorage.
ODS_DATA_KEY_BASE64=
# Valeurs du mode serveur ; le VSIX impose loopback, port dynamique et profil local.
ODS_BIND_ADDRESS=127.0.0.1
ODS_GATEWAY_PORT=8080
SPRING_PROFILES_ACTIVE=local
