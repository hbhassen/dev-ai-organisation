{
  "name": "organisation-development-standard",
  "displayName": "Organisation Development Standard",
  "description": "Five governed development views with Java engine, Mistral agent, quality, security and GitFlow.",
  "version": "0.3.1",
  "publisher": "ods-internal",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:ods.workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Project reads, execution and changes require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ods.open",
        "title": "ODS: Ouvrir les outils"
      },
      {
        "command": "ods.signOut",
        "title": "ODS: Déconnexion"
      },
      {
        "command": "ods.connect",
        "title": "ODS: Vérifier l’accès Git et connecter"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ods",
          "title": "ODS",
          "icon": "media/ods.svg"
        }
      ]
    },
    "views": {
      "ods": [
        {
          "id": "ods.workspace",
          "name": "Development Standard",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "ODS",
      "properties": {
        "ods.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Exécutable Java 21 du poste.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "lint": "node scripts/check-docs.cjs",
    "test": "node --test test/*.test.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license --out ../.artifacts/organisation-development-standard-0.3.1.vsix",
    "vscode:prepublish": "npm run compile && npm run lint",
    "test:ui": "playwright test",
    "browser:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "5.9.3"
  }
}
