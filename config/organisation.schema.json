{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ODS organisation build profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "extension",
    "gatewayUrl"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,49}$"
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "publisher",
        "displayName"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,69}$"
        },
        "publisher": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,69}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        }
      }
    },
    "gatewayUrl": {
      "type": "string",
      "format": "uri"
    },
    "envFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(ODS_[A-Z0-9_]+|SPRING_PROFILES_ACTIVE)$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        }
      }
    }
  }
}
