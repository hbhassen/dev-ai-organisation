# Dual-provider build profile. Values are required from the build environment and never stored here. DEVAI-167, DEVAI-189, DEVAI-195, DEVAI-196.
ODS_GITLAB_URL=https://gitlab.organisation.example
ODS_GOVERNANCE_PROJECT_ID=<GOVERNANCE_PROJECT_ID>
ODS_GOVERNANCE_REF=main
ODS_GOVERNANCE_TOKEN=<READ_ONLY_GOVERNANCE_TOKEN>
ODS_POLICY_PUBLIC_KEY=<ED25519_DER_PUBLIC_KEY_BASE64>
ODS_MISTRAL_URL=https://api.mistral.ai
ODS_MISTRAL_MODEL=${MISTRAL_MODEL}
ODS_MODEL_ALIAS=mistral-approved
ODS_MISTRAL_API_KEY=${MISTRAL_API_KEY}
ODS_OPENAI_API_KEY=${OPENAI_API_KEY}
ODS_PROVIDER_REGISTRY=[{"id":"OPENAI","backend":"generic","apiStyle":"openai","apiBase":"https://api.openai.com/v1","allowedHosts":["api.openai.com"],"credentialRef":"ODS_OPENAI_API_KEY","generation":true,"tools":true,"streaming":false,"images":false,"usage":true}]
ODS_LLM_TRANSPORT=VIBE_CLI
ODS_VIBE_URL=https://api.mistral.ai/v1
ODS_VIBE_AUTH=API_KEY
ODS_SONAR_URL=https://sonar.organisation.example
ODS_SONAR_TOKEN=<SONAR_READ_TOKEN>
ODS_JFROG_URL=https://jfrog.organisation.example
ODS_JFROG_AUTH=TOKEN
ODS_JFROG_TOKEN=<XRAY_READ_TOKEN>
ODS_DATA_KEY_BASE64=
ODS_BIND_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local
